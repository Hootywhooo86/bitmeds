<?xml version="1.0" encoding="utf-8"?>
<!-- Every part stretches with the widget (weights + auto-sized text), so there is no dead space at any size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- pixel panel: hard black shadow + fill and border tinted to the med's colours -->
    <ImageView android:id="@+id/panel_shadow" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="4dp" android:layout_marginTop="4dp" android:background="#000000" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/panel_fill" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY" android:importantForAccessibility="no"
        android:src="@drawable/solid_white" android:tint="#101428" />
    <ImageView android:id="@+id/panel_border" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY" android:importantForAccessibility="no"
        android:src="@drawable/stroke_white" android:tint="#2a2a4a" />

    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="8dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="11dp">
        <FrameLayout android:id="@+id/art_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="54">
            <ViewFlipper android:id="@+id/flipper" android:layout_width="match_parent" android:layout_height="match_parent"
                android:autoStart="true" android:flipInterval="300">
                    <ImageView android:id="@+id/f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_ring_preview" />
                    <ImageView android:id="@+id/f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/f2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/f3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            </ViewFlipper>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="15" android:orientation="horizontal">
            <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:ellipsize="end" android:fontFamily="@font/press_start" android:gravity="center"
                android:text="Testosterone" android:textColor="#f4f1ff" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="4sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/cycle" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center"
                android:paddingStart="4dp" android:fontFamily="@font/press_start" android:text="▸▸" android:textColor="#a78bfa"
                android:textSize="8sp" android:visibility="gone" />
        </LinearLayout>
        <Chronometer android:id="@+id/chrono" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="31"
            android:fontFamily="@font/press_start" android:gravity="center" android:text="2D 13:58:27" android:textColor="#34d399" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="60sp" android:autoSizeStepGranularity="1sp" />
        <!-- dose + due: shown when the med is "text only", so the space the animation used is filled -->
        <LinearLayout android:id="@+id/small_extra" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="26"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/dose" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:ellipsize="end" android:gravity="center" android:text="0.5 ml" android:textColor="#facc15" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/due" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:ellipsize="end" android:gravity="center" android:text="due today 8:00 PM" android:textColor="#9a97b8" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <TextView android:id="@+id/site" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <FrameLayout android:id="@+id/give" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="5dp">
            <ImageView android:id="@+id/give_shadow" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#047857" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/give_face" android:layout_width="match_parent" android:layout_height="match_parent"
                android:layout_marginBottom="4dp" android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#34d399" android:importantForAccessibility="no" />
            <TextView android:id="@+id/give_text" android:layout_width="match_parent" android:layout_height="match_parent"
                android:fontFamily="@font/press_start" android:gravity="center" android:paddingStart="6dp" android:paddingTop="3dp" android:paddingEnd="6dp" android:paddingBottom="7dp"
                android:text="↺ GAVE IT" android:textColor="#0b0b16" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
        </FrameLayout>
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:gravity="center" android:visibility="gone"
        android:fontFamily="@font/press_start" android:lineSpacingExtra="6dp" android:text="NO MEDS YET\nTAP TO OPEN bitmeds"
        android:textColor="#9a97b8" android:textSize="8sp" />
</FrameLayout>
