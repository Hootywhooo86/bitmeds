<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- pixel panel: hard black shadow + fill and border tinted to the med's colours -->
    <ImageView android:id="@+id/panel_shadow" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="4dp" android:layout_marginTop="4dp" android:background="#000000" />
    <ImageView android:id="@+id/panel_fill" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY"
        android:src="@drawable/solid_white" android:tint="#101428" />
    <ImageView android:id="@+id/panel_border" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY"
        android:src="@drawable/stroke_white" android:tint="#2a2a4a" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="7dp"
        android:paddingEnd="13dp"
        android:paddingBottom="11dp">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <ViewFlipper
                android:id="@+id/flipper"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:autoStart="true"
                android:flipInterval="300">
                <ImageView android:id="@+id/f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_ring_preview" />
                <ImageView android:id="@+id/f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/f2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/f3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            </ViewFlipper>
            <TextView
                android:id="@+id/cycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="0dp"
                android:fontFamily="@font/press_start"
                android:text="▸▸"
                android:textColor="#a78bfa"
                android:textSize="8sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/press_start"
            android:gravity="center"
            android:singleLine="true"
            android:text="Testosterone"
            android:textColor="#f4f1ff"
            android:textSize="7sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start"
                android:text="2D "
                android:textColor="#34d399"
                android:textSize="10sp" />
            <Chronometer
                android:id="@+id/chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start"
                android:singleLine="true"
                android:text="13:58:27"
                android:textColor="#34d399"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- not shown in the small size, but the ids must exist -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/dose" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/due" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/site" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/give"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="5dp">
            <ImageView android:id="@+id/give_shadow" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#047857" />
            <ImageView android:id="@+id/give_face" android:layout_width="match_parent" android:layout_height="match_parent"
                android:layout_marginBottom="4dp" android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#34d399" />
            <TextView
                android:id="@+id/give_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/press_start"
                android:gravity="center"
                android:paddingBottom="4dp"
                android:text="↺ GAVE IT"
                android:textColor="#0b0b16"
                android:textSize="7sp" />
        </FrameLayout>
    </LinearLayout>

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:visibility="gone"
            android:fontFamily="@font/press_start"
            android:lineSpacingExtra="6dp"
            android:text="NO MEDS YET\nTAP TO OPEN bitmeds"
            android:textColor="#9a97b8"
            android:textSize="8sp" />
    </LinearLayout>
</FrameLayout>
