<?xml version="1.0" encoding="utf-8"?>
<!-- The whole widget is one pixel-art picture drawn by WidgetArt at the widget's real size (so the pixel font
     shows on every launcher). The live animation and the GAVE IT tap area are placed over it from code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_preview" android:contentDescription="@string/app_name" />
    <ViewFlipper android:id="@+id/flip" android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="top|start"
        android:layout_marginStart="16dp" android:layout_marginTop="16dp" android:autoStart="true" android:flipInterval="300">
        <ImageView android:id="@+id/f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/f2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/f3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
    </ViewFlipper>
    <FrameLayout android:id="@+id/give" android:layout_width="match_parent" android:layout_height="40dp" android:layout_gravity="bottom"
        android:layout_marginStart="14dp" android:layout_marginEnd="18dp" android:layout_marginBottom="18dp" android:contentDescription="Gave it" />
</FrameLayout>
