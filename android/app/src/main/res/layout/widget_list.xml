<?xml version="1.0" encoding="utf-8"?>
<!-- Rows share the height (weights), so 1-4 meds always fill the widget; text auto-sizes into each square. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- pixel panel: hard black shadow + fill and border tinted to the med's colours -->
    <ImageView android:id="@+id/panel_shadow" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="4dp" android:layout_marginTop="4dp" android:background="#000000" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/panel_fill" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY" android:importantForAccessibility="no"
        android:src="@drawable/solid_white" android:tint="#101428" />
    <ImageView android:id="@+id/panel_border" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY" android:importantForAccessibility="no"
        android:src="@drawable/stroke_white" android:tint="#2a2a4a" />

    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="8dp" android:paddingTop="4dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
        <LinearLayout android:id="@+id/list_header" android:layout_width="match_parent" android:layout_height="18dp" android:layout_marginTop="3dp"
            android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/list_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/press_start" android:text="bitmeds" android:textColor="#34d399" android:textSize="9sp" />
            <TextView android:id="@+id/list_status" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="8dp" android:fontFamily="@font/press_start" android:gravity="end|center_vertical"
                android:text="2 MEDS · ALL GOOD" android:textColor="#9a97b8" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="4sp" android:autoSizeMaxTextSize="8sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <FrameLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="4dp">
            <!-- each med sits in its own square, in its own colours -->
            <ImageView android:id="@+id/r0_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#141a33" />
            <ImageView android:id="@+id/r0_line" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                android:scaleType="fitXY" android:src="@drawable/stroke_white" android:tint="#2a2a4a" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:baselineAligned="false"
                android:orientation="horizontal" android:padding="5dp">
                <ViewFlipper android:id="@+id/r0_flip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="20"
                    android:autoStart="true" android:flipInterval="300">
                    <ImageView android:id="@+id/r0_f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_ring_preview" />
                    <ImageView android:id="@+id/r0_f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/r0_f2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/r0_f3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                </ViewFlipper>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="54"
                    android:layout_marginStart="6dp" android:orientation="vertical">
                    <TextView android:id="@+id/r0_name" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="40"
                        android:ellipsize="end" android:fontFamily="@font/press_start" android:gravity="bottom" android:paddingBottom="2dp"
                        android:text="Testosterone" android:textColor="#f4f1ff" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="4sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
                    <Chronometer android:id="@+id/r0_chrono" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="60"
                        android:fontFamily="@font/press_start" android:gravity="center_vertical" android:text="2D 13:58:27" android:textColor="#34d399" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="40sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
                <FrameLayout android:id="@+id/r0_give" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="26"
                    android:layout_marginStart="6dp">
                    <ImageView android:id="@+id/r0_give_shadow" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                        android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#047857" />
                    <ImageView android:id="@+id/r0_give_face" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                        android:layout_marginBottom="3dp" android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#34d399" />
                    <TextView android:id="@+id/r0_give_text" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:fontFamily="@font/press_start" android:gravity="center" android:padding="4dp" android:paddingBottom="7dp"
                        android:text="↺ GAVE" android:textColor="#0b0b16" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="4sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="4dp">
            <!-- each med sits in its own square, in its own colours -->
            <ImageView android:id="@+id/r1_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#141a33" />
            <ImageView android:id="@+id/r1_line" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                android:scaleType="fitXY" android:src="@drawable/stroke_white" android:tint="#2a2a4a" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:baselineAligned="false"
                android:orientation="horizontal" android:padding="5dp">
                <ViewFlipper android:id="@+id/r1_flip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="20"
                    android:autoStart="true" android:flipInterval="300">
                    <ImageView android:id="@+id/r1_f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_ring_preview" />
                    <ImageView android:id="@+id/r1_f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/r1_f2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/r1_f3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                </ViewFlipper>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="54"
                    android:layout_marginStart="6dp" android:orientation="vertical">
                    <TextView android:id="@+id/r1_name" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="40"
                        android:ellipsize="end" android:fontFamily="@font/press_start" android:gravity="bottom" android:paddingBottom="2dp"
                        android:text="Vitamin D" android:textColor="#f4f1ff" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="4sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
                    <Chronometer android:id="@+id/r1_chrono" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="60"
                        android:fontFamily="@font/press_start" android:gravity="center_vertical" android:text="4:59:55" android:textColor="#34d399" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="40sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
                <FrameLayout android:id="@+id/r1_give" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="26"
                    android:layout_marginStart="6dp">
                    <ImageView android:id="@+id/r1_give_shadow" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                        android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#047857" />
                    <ImageView android:id="@+id/r1_give_face" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                        android:layout_marginBottom="3dp" android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#34d399" />
                    <TextView android:id="@+id/r1_give_text" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:fontFamily="@font/press_start" android:gravity="center" android:padding="4dp" android:paddingBottom="7dp"
                        android:text="↺ GAVE" android:textColor="#0b0b16" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="4sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="4dp" android:visibility="gone">
            <!-- each med sits in its own square, in its own colours -->
            <ImageView android:id="@+id/r2_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#141a33" />
            <ImageView android:id="@+id/r2_line" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                android:scaleType="fitXY" android:src="@drawable/stroke_white" android:tint="#2a2a4a" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:baselineAligned="false"
                android:orientation="horizontal" android:padding="5dp">
                <ViewFlipper android:id="@+id/r2_flip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="20"
                    android:autoStart="true" android:flipInterval="300">
                    <ImageView android:id="@+id/r2_f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_ring_preview" />
                    <ImageView android:id="@+id/r2_f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/r2_f2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/r2_f3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                </ViewFlipper>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="54"
                    android:layout_marginStart="6dp" android:orientation="vertical">
                    <TextView android:id="@+id/r2_name" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="40"
                        android:ellipsize="end" android:fontFamily="@font/press_start" android:gravity="bottom" android:paddingBottom="2dp"
                        android:text="" android:textColor="#f4f1ff" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="4sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
                    <Chronometer android:id="@+id/r2_chrono" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="60"
                        android:fontFamily="@font/press_start" android:gravity="center_vertical" android:text="" android:textColor="#34d399" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="40sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
                <FrameLayout android:id="@+id/r2_give" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="26"
                    android:layout_marginStart="6dp">
                    <ImageView android:id="@+id/r2_give_shadow" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                        android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#047857" />
                    <ImageView android:id="@+id/r2_give_face" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                        android:layout_marginBottom="3dp" android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#34d399" />
                    <TextView android:id="@+id/r2_give_text" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:fontFamily="@font/press_start" android:gravity="center" android:padding="4dp" android:paddingBottom="7dp"
                        android:text="↺ GAVE" android:textColor="#0b0b16" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="4sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="4dp" android:visibility="gone">
            <!-- each med sits in its own square, in its own colours -->
            <ImageView android:id="@+id/r3_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#141a33" />
            <ImageView android:id="@+id/r3_line" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                android:scaleType="fitXY" android:src="@drawable/stroke_white" android:tint="#2a2a4a" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:baselineAligned="false"
                android:orientation="horizontal" android:padding="5dp">
                <ViewFlipper android:id="@+id/r3_flip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="20"
                    android:autoStart="true" android:flipInterval="300">
                    <ImageView android:id="@+id/r3_f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_ring_preview" />
                    <ImageView android:id="@+id/r3_f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/r3_f2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/r3_f3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                </ViewFlipper>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="54"
                    android:layout_marginStart="6dp" android:orientation="vertical">
                    <TextView android:id="@+id/r3_name" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="40"
                        android:ellipsize="end" android:fontFamily="@font/press_start" android:gravity="bottom" android:paddingBottom="2dp"
                        android:text="" android:textColor="#f4f1ff" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="4sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
                    <Chronometer android:id="@+id/r3_chrono" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="60"
                        android:fontFamily="@font/press_start" android:gravity="center_vertical" android:text="" android:textColor="#34d399" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="40sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
                <FrameLayout android:id="@+id/r3_give" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="26"
                    android:layout_marginStart="6dp">
                    <ImageView android:id="@+id/r3_give_shadow" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                        android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#047857" />
                    <ImageView android:id="@+id/r3_give_face" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"
                        android:layout_marginBottom="3dp" android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#34d399" />
                    <TextView android:id="@+id/r3_give_text" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:fontFamily="@font/press_start" android:gravity="center" android:padding="4dp" android:paddingBottom="7dp"
                        android:text="↺ GAVE" android:textColor="#0b0b16" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="4sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:gravity="center" android:visibility="gone"
        android:fontFamily="@font/press_start" android:lineSpacingExtra="6dp" android:text="NO MEDS YET\nTAP TO OPEN bitmeds"
        android:textColor="#9a97b8" android:textSize="8sp" />
</FrameLayout>
