<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/panel_shadow" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="4dp" android:layout_marginTop="4dp" android:background="#000000" />
    <ImageView android:id="@+id/panel_fill" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY"
        android:src="@drawable/solid_white" android:tint="#0b0b16" />
    <ImageView android:id="@+id/panel_border" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY"
        android:src="@drawable/stroke_white" android:tint="#2a2a4a" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/list_header"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/list_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start"
                android:text="bitmeds"
                android:textColor="#34d399"
                android:textSize="8sp" />
            <TextView
                android:id="@+id/list_status"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/press_start"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:text="2 MEDS · ALL GOOD"
                android:textColor="#9a97b8"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="4sp"
                android:autoSizeMaxTextSize="7sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>

    <FrameLayout
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">
        <!-- each med sits in its own square, in its own colours -->
        <ImageView android:id="@+id/r0_bg" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#141a33" />
        <ImageView android:id="@+id/r0_line" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitXY" android:src="@drawable/stroke_white" android:tint="#2a2a4a" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="6dp">
            <ViewFlipper
                android:id="@+id/r0_flip"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:autoStart="true"
                android:flipInterval="300">
                <ImageView android:id="@+id/r0_f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/widget_ring_preview" />
                <ImageView android:id="@+id/r0_f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/r0_f2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/r0_f3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            </ViewFlipper>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/r0_name"
                    android:ellipsize="end"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:fontFamily="@font/press_start"
                    android:maxLines="1"
                    android:text="Testosterone"
                    android:textColor="#f4f1ff"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="4sp"
                    android:autoSizeMaxTextSize="8sp"
                    android:autoSizeStepGranularity="1sp" />
                <Chronometer
                    android:id="@+id/r0_chrono"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/press_start"
                    android:maxLines="1"
                    android:text="2D 13:58:27"
                    android:textColor="#34d399"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="5sp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeStepGranularity="1sp" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/r0_give"
                android:layout_width="56dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp">
                <ImageView android:id="@+id/r0_give_shadow" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#047857" />
                <ImageView android:id="@+id/r0_give_face" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_marginBottom="3dp" android:scaleType="fitXY" android:src="@drawable/solid_white" android:tint="#34d399" />
                <TextView
                    android:id="@+id/r0_give_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/press_start"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingBottom="3dp"
                    android:text="↺ GAVE"
                    android:textColor="#0b0b16"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="4sp"
                    android:autoSizeMaxTextSize="7sp"
                    android:autoSizeStepGranularity="1sp" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
