        <ImageView android:id="@+id/r1_line" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitXY" android:src="@drawable/stroke_white" android:tint="#2a2a4a" />
        <LinearLayout
            android:layout_width="match_parent"
